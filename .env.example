# ============================================================================
# Wedding Platform — Production & Local Environment Configuration
# ============================================================================

# 1. PostgreSQL Connection String
# For local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding_platform"
# Set to "true" if your managed PostgreSQL provider requires SSL (Supabase, Neon, RDS, Railway)
DATABASE_SSL="false"

# 2. Backend Server Port & Node Environment
PORT=4000
NODE_ENV="development"

# 3. Authentication & Security (REQUIRED IN PRODUCTION)
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET="replace-with-a-64-char-random-hex-secret-in-production"

# Comma-separated list of allowed frontend origins for CORS & cookies
ALLOWED_ORIGIN="http://localhost:3000"

# Set to "false" in production so demo accounts/weddings are not auto-seeded
SEED_DEMO_DATA="true"

# 4. Frontend -> Backend API URL
NEXT_PUBLIC_API_URL="http://localhost:4000"

# 5. Optional: Official Meta WhatsApp Cloud API (for automated batch sending)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
