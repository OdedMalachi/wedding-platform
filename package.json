{
  "name": "wedding-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Wedding Platform Monorepo — Separate wedding-web (Frontend) and wedding-api (Backend)",
  "workspaces": [
    "wedding-api",
    "wedding-web"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:api": "npm --prefix wedding-api run dev",
    "dev:web": "npm --prefix wedding-web run dev",
    "build:web": "npm --prefix wedding-web run build",
    "typecheck:api": "npm --prefix wedding-api run typecheck",
    "typecheck:web": "npm --prefix wedding-web run typecheck",
    "test:api": "npm --prefix wedding-api run test"
  },
  "dependencies": {
    "drizzle-orm": "^0.40.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "pg": "^8.13.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "drizzle-kit": "^0.30.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
